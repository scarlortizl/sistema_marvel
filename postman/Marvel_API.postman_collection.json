        {
          "name": "Mision sin fecha (422)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{base_url}}/misiones", "host": ["{{base_url}}"], "path": ["misiones"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Mision sin fecha\",\n  \"descripcion\": \"Falta la fecha obligatoria\",\n  \"ubicacion\": \"Quito\",\n  \"nivel_peligro\": \"BAJO\",\n  \"superheroe_id\": {{heroe_id}}\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Responde 422', () => pm.response.to.have.status(422));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Cierre de sesion",
      "item": [
        {
          "name": "Logout del usuario CONSULTA",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_consulta}}" }],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "El token cerrado ya no sirve (401)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_consulta}}" }],
            "url": { "raw": "{{base_url}}/heroes", "host": ["{{base_url}}"], "path": ["heroes"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 401 porque el token fue revocado', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
